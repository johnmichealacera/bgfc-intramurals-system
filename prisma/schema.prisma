generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TABULATOR
}

enum SportEventType {
  TEAM_VS_TEAM
  PLACEMENT
}

enum SportEventCategory {
  MEN
  WOMEN
  MIXED
}

enum SportEventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Sport {
  id        String         @id @default(cuid())
  name      String         @unique
  type      SportEventType
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("sports")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(TABULATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  eventAssignments EventTabulator[]
  scoredMatches    Match[]          @relation("MatchUpdatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Season {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        Team[]
  events       SportEvent[]
  pointRules   PlacementPointsRule[]
  participants Participant[]

  @@index([isActive])
  @@map("seasons")
}

model Team {
  id        String   @id @default(cuid())
  seasonId  String
  name      String
  colorHex  String   @default("#0f766e")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  homeMatches  Match[]          @relation("MatchHomeTeam")
  awayMatches  Match[]          @relation("MatchAwayTeam")
  wonMatches   Match[]          @relation("MatchWinnerTeam")
  placements   EventPlacement[]
  participants Participant[]
  eventTeams   EventTeam[]

  @@unique([seasonId, name])
  @@index([seasonId])
  @@map("teams")
}

enum ParticipantGender {
  MALE
  FEMALE
}

model Participant {
  id        String             @id @default(cuid())
  seasonId  String
  teamId    String?
  fullName  String
  course    String
  yearLevel String?
  gender    ParticipantGender?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  season       Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  eventEntries EventParticipant[]

  @@index([seasonId])
  @@index([teamId])
  @@map("participants")
}

model SportEvent {
  id          String              @id @default(cuid())
  seasonId    String
  name        String
  type        SportEventType
  category    SportEventCategory?
  status      SportEventStatus    @default(UPCOMING)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  season     Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  tabulators EventTabulator[]
  eventTeams EventTeam[]
  matches    Match[]
  placements EventPlacement[]

  @@index([seasonId, status])
  @@map("sport_events")
}

model EventTeam {
  id           String   @id @default(cuid())
  sportEventId String
  teamId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sportEvent   SportEvent         @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  participants EventParticipant[]

  @@unique([sportEventId, teamId])
  @@index([sportEventId])
  @@index([teamId])
  @@map("event_teams")
}

model EventParticipant {
  id            String   @id @default(cuid())
  eventTeamId   String
  participantId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventTeam   EventTeam   @relation(fields: [eventTeamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventTeamId, participantId])
  @@index([eventTeamId])
  @@index([participantId])
  @@map("event_participants")
}

model EventTabulator {
  id           String   @id @default(cuid())
  sportEventId String
  userId       String
  createdAt    DateTime @default(now())

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sportEventId, userId])
  @@index([userId])
  @@map("event_tabulators")
}

model Match {
  id              String      @id @default(cuid())
  sportEventId    String
  homeTeamId      String
  awayTeamId      String
  homeScore       Int         @default(0)
  awayScore       Int         @default(0)
  status          MatchStatus @default(SCHEDULED)
  winnerTeamId    String?
  scheduledAt     DateTime
  venue           String?
  updatedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Restrict)
  homeTeam   Team       @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam   Team       @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  winnerTeam Team?      @relation("MatchWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: Restrict)
  updatedBy  User?      @relation("MatchUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([sportEventId, status])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}

model EventPlacement {
  id           String   @id @default(cuid())
  sportEventId String
  teamId       String
  placement    Int
  points       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Restrict)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([sportEventId, teamId])
  @@unique([sportEventId, placement])
  @@index([sportEventId])
  @@index([teamId])
  @@map("event_placements")
}

model PlacementPointsRule {
  id        String   @id @default(cuid())
  seasonId  String
  placement Int
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, placement])
  @@map("placement_points_rules")
}
