generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TABULATOR
}

enum SportEventType {
  TEAM_VS_TEAM
  PLACEMENT
}

enum SportEventCategory {
  MEN
  WOMEN
  MIXED
}

enum SportEventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Sport {
  id        String         @id @default(cuid())
  name      String         @unique
  type      SportEventType
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("sports")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum MatchPhase {
  ROUND_ROBIN
  ELIMINATION
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(TABULATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  eventAssignments           EventTabulator[]
  scoredMatches              Match[]           @relation("MatchUpdatedBy")
  resumeRequests             Match[]           @relation("MatchResumeRequestedBy")
  resumeApprovals            Match[]           @relation("MatchResumeApprovedBy")
  matchControlRequests       Match[]           @relation("MatchControlRequestedBy")
  matchControlApprovals      Match[]           @relation("MatchControlApprovedBy")
  scoredSchedules            EventSchedule[]   @relation("ScheduleUpdatedBy")
  scheduleResumeRequests     EventSchedule[]   @relation("ScheduleResumeRequestedBy")
  scheduleResumeApprovals    EventSchedule[]   @relation("ScheduleResumeApprovedBy")
  scheduleControlRequests    EventSchedule[]   @relation("ScheduleControlRequestedBy")
  scheduleControlApprovals   EventSchedule[]   @relation("ScheduleControlApprovedBy")
  matchScoreCorrections      Match[]           @relation("MatchScoreCorrectedBy")
  scheduleScoreCorrections   EventSchedule[]   @relation("ScheduleScoreCorrectedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Season {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        Team[]
  events       SportEvent[]
  pointRules   PlacementPointsRule[]
  participants Participant[]

  @@index([isActive])
  @@map("seasons")
}

model Team {
  id        String   @id @default(cuid())
  seasonId  String
  name      String
  colorHex  String   @default("#0f766e")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  homeMatches     Match[]            @relation("MatchHomeTeam")
  awayMatches     Match[]            @relation("MatchAwayTeam")
  wonMatches      Match[]            @relation("MatchWinnerTeam")
  bracketHome     EventBracketGame[] @relation("BracketHomeTeam")
  bracketAway     EventBracketGame[] @relation("BracketAwayTeam")
  bracketWins     EventBracketGame[] @relation("BracketWinnerTeam")
  placements      EventPlacement[]
  participants    Participant[]
  eventTeams      EventTeam[]
  scheduleScores  EventScheduleScore[]

  @@unique([seasonId, name])
  @@index([seasonId])
  @@map("teams")
}

enum ParticipantGender {
  MALE
  FEMALE
}

model Participant {
  id        String             @id @default(cuid())
  seasonId  String
  teamId    String?
  fullName  String
  course    String
  yearLevel String?
  gender    ParticipantGender?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  season       Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  eventEntries EventParticipant[]

  @@index([seasonId])
  @@index([teamId])
  @@map("participants")
}

model SportEvent {
  id          String              @id @default(cuid())
  seasonId    String
  name        String
  type        SportEventType
  category    SportEventCategory?
  status      SportEventStatus    @default(UPCOMING)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  season     Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  tabulators EventTabulator[]
  eventTeams    EventTeam[]
  schedules     EventSchedule[]
  matches       Match[]
  bracketGames  EventBracketGame[]
  placements    EventPlacement[]

  @@index([seasonId, status])
  @@map("sport_events")
}

model EventSchedule {
  id                       String      @id @default(cuid())
  sportEventId             String
  title                    String?
  scheduledAt              DateTime
  venue                    String?
  status                   MatchStatus @default(SCHEDULED)
  postponeReason           String?
  resumeRequestedAt        DateTime?
  resumeApprovedAt         DateTime?
  resumeRequestedByUserId  String?
  resumeApprovedByUserId   String?
  resumeRequestReason      String?
  controlRequestedAt       DateTime?
  controlApprovedAt        DateTime?
  controlRequestedByUserId String?
  controlApprovedByUserId  String?
  controlRequestReason     String?
  scoreCorrectedAt         DateTime?
  scoreCorrectedByUserId   String?
  scoreCorrectionReason    String?
  updatedByUserId          String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  sportEvent        SportEvent           @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  scores            EventScheduleScore[]
  updatedBy         User?                @relation("ScheduleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  scoreCorrectedBy  User?                @relation("ScheduleScoreCorrectedBy", fields: [scoreCorrectedByUserId], references: [id], onDelete: SetNull)
  resumeRequestedBy User?                @relation("ScheduleResumeRequestedBy", fields: [resumeRequestedByUserId], references: [id], onDelete: SetNull)
  resumeApprovedBy  User?                @relation("ScheduleResumeApprovedBy", fields: [resumeApprovedByUserId], references: [id], onDelete: SetNull)
  controlRequestedBy User?               @relation("ScheduleControlRequestedBy", fields: [controlRequestedByUserId], references: [id], onDelete: SetNull)
  controlApprovedBy  User?               @relation("ScheduleControlApprovedBy", fields: [controlApprovedByUserId], references: [id], onDelete: SetNull)

  @@index([sportEventId])
  @@index([scheduledAt])
  @@index([status])
  @@map("event_schedules")
}

model EventScheduleScore {
  id         String   @id @default(cuid())
  scheduleId String
  teamId     String
  score      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule EventSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  team     Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, teamId])
  @@index([scheduleId])
  @@index([teamId])
  @@map("event_schedule_scores")
}

model EventTeam {
  id           String   @id @default(cuid())
  sportEventId String
  teamId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sportEvent   SportEvent         @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  participants EventParticipant[]

  @@unique([sportEventId, teamId])
  @@index([sportEventId])
  @@index([teamId])
  @@map("event_teams")
}

model EventParticipant {
  id            String   @id @default(cuid())
  eventTeamId   String
  participantId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventTeam   EventTeam   @relation(fields: [eventTeamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventTeamId, participantId])
  @@index([eventTeamId])
  @@index([participantId])
  @@map("event_participants")
}

model EventTabulator {
  id           String   @id @default(cuid())
  sportEventId String
  userId       String
  createdAt    DateTime @default(now())

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sportEventId, userId])
  @@index([userId])
  @@map("event_tabulators")
}

model Match {
  id                      String      @id @default(cuid())
  sportEventId            String
  homeTeamId              String
  awayTeamId              String
  homeScore               Int         @default(0)
  awayScore               Int         @default(0)
  status                  MatchStatus @default(SCHEDULED)
  phase                   MatchPhase  @default(ROUND_ROBIN)
  winnerTeamId            String?
  scheduledAt             DateTime
  venue                   String?
  updatedByUserId         String?
  postponeReason          String?
  resumeRequestedAt       DateTime?
  resumeApprovedAt        DateTime?
  resumeRequestedByUserId String?
  resumeApprovedByUserId  String?
  resumeRequestReason      String?
  controlRequestedAt       DateTime?
  controlApprovedAt        DateTime?
  controlRequestedByUserId String?
  controlApprovedByUserId  String?
  controlRequestReason     String?
  scoreCorrectedAt         DateTime?
  scoreCorrectedByUserId   String?
  scoreCorrectionReason    String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  sportEvent         SportEvent         @relation(fields: [sportEventId], references: [id], onDelete: Restrict)
  homeTeam           Team               @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam           Team               @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  winnerTeam         Team?              @relation("MatchWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: Restrict)
  updatedBy          User?              @relation("MatchUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  scoreCorrectedBy   User?              @relation("MatchScoreCorrectedBy", fields: [scoreCorrectedByUserId], references: [id], onDelete: SetNull)
  resumeRequestedBy  User?              @relation("MatchResumeRequestedBy", fields: [resumeRequestedByUserId], references: [id], onDelete: SetNull)
  resumeApprovedBy   User?              @relation("MatchResumeApprovedBy", fields: [resumeApprovedByUserId], references: [id], onDelete: SetNull)
  controlRequestedBy User?              @relation("MatchControlRequestedBy", fields: [controlRequestedByUserId], references: [id], onDelete: SetNull)
  controlApprovedBy  User?              @relation("MatchControlApprovedBy", fields: [controlApprovedByUserId], references: [id], onDelete: SetNull)
  bracketGame        EventBracketGame?

  @@index([sportEventId, status])
  @@index([sportEventId, phase])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}

model EventBracketGame {
  id           String  @id @default(cuid())
  sportEventId String
  round        Int
  position     Int
  homeTeamId   String?
  awayTeamId   String?
  winnerTeamId String?
  matchId      String? @unique
  nextGameId   String?
  nextSlot     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Cascade)
  homeTeam   Team?      @relation("BracketHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam   Team?      @relation("BracketAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerTeam Team?      @relation("BracketWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  match      Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  nextGame   EventBracketGame?  @relation("BracketNextGame", fields: [nextGameId], references: [id], onDelete: SetNull)
  previous   EventBracketGame[] @relation("BracketNextGame")

  @@unique([sportEventId, round, position])
  @@index([sportEventId])
  @@index([nextGameId])
  @@map("event_bracket_games")
}

model EventPlacement {
  id           String   @id @default(cuid())
  sportEventId String
  teamId       String
  placement    Int
  points       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sportEvent SportEvent @relation(fields: [sportEventId], references: [id], onDelete: Restrict)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([sportEventId, teamId])
  @@unique([sportEventId, placement])
  @@index([sportEventId])
  @@index([teamId])
  @@map("event_placements")
}

model PlacementPointsRule {
  id        String         @id @default(cuid())
  seasonId  String
  eventType SportEventType
  placement Int
  points    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, eventType, placement])
  @@index([seasonId, eventType])
  @@map("placement_points_rules")
}
